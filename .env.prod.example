# ==================================================
# 生产环境配置模板
# ==================================================
# 使用说明：
# 1. 复制此文件为 .env.prod
#    cp .env.prod.example .env.prod
# 2. 编辑 .env.prod，填入真实的配置值
# 3. 使用生产配置启动
#    docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ⚠️ 安全警告：
# - .env.prod 包含敏感信息，不要提交到git
# - 必须修改所有标记为 <必须修改> 的配置项
# ==================================================

# Application
APP_NAME=WealthWhisker
APP_VERSION=v1.0.0
DEBUG=false
ENVIRONMENT=production

# API
API_PORT=8000
SECRET_KEY=<必须修改：生成强随机密钥>
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
CORS_ORIGINS=<必须修改：生产域名，如https://your-domain.com>

# Database（必须修改密码）
POSTGRES_PASSWORD=<必须修改：强随机密码>
POSTGRES_DB=wealthwhisker

# External APIs（必须填入真实密钥）
OKX_API_KEY=<必须填入：OKX API Key>
OKX_API_SECRET=<必须填入：OKX API Secret>
OKX_API_PASSPHRASE=<必须填入：OKX Passphrase>

ALPHA_VANTAGE_API_KEY=<可选：Alpha Vantage API Key>

# News APIs（可选）
CRYPTOPANIC_API_KEY=<可选：CryptoPanic API Key>
NEWSAPI_KEY=<可选：NewsAPI Key>

# LLM Configuration（必须填入真实配置）
LLM_ENABLED=true
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=<必须填入：LLM API Key>
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7

# API URLs（默认值通常可用）
YAHOO_FINANCE_API_URL=https://query1.finance.yahoo.com
CRYPTOPANIC_API_URL=https://cryptopanic.com/api/v1/post/
NEWSAPI_URL=https://newsapi.org/v2
EASTMONEY_API_URL=http://fund.eastmoney.com
EASTMONEY_FUNDGZ_API_URL=http://fundgz.eastmoney.com
ALPHA_VANTAGE_API_URL=https://www.alphavantage.co

# API Timeout（秒）
API_REQUEST_TIMEOUT=30
NEWS_API_TIMEOUT=15

# Data Sync Limits（可根据需求调整）
CRYPTO_KLINE_LIMIT=168
STOCK_KLINE_LIMIT=30
FUND_DATA_LIMIT=30
NEWS_SYNC_LIMIT=20
MACRO_NEWS_LIMIT=10

# Model Calibration
CALIBRATION_THRESHOLD=0.05
CRYPTO_CALIBRATION_INTERVAL_HOURS=4
STOCK_CALIBRATION_SCHEDULE=17:00

# Proxy（可选，生产环境通常不需要）
# 如果生产环境需要代理访问外部API，请配置
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080

# ==================================================
# 配置验证清单
# ==================================================
# ✅ SECRET_KEY: 已修改为强随机密钥
# ✅ POSTGRES_PASSWORD: 已修改为强密码
# ✅ CORS_ORIGINS: 已配置生产域名
# ✅ OKX_API_KEY/SECRET/PASSPHRASE: 已填入真实密钥
# ✅ LLM_API_KEY: 已填入真实密钥
# ✅ DEBUG: 已设置为false
# ✅ ENVIRONMENT: 已设置为production
# ==================================================