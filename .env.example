# Application
APP_NAME=WealthWhisker
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
API_PORT=8000

# Database（本地开发使用localhost，Docker使用容器服务名postgres）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wealthwhisker
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/wealthwhisker
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wealthwhisker

# Redis（本地开发使用localhost）
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External APIs（请填入真实密钥）
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_API_URL=https://www.okx.com

# Yahoo Finance（免费，无需API密钥）
YAHOO_FINANCE_ENABLED=true
YAHOO_FINANCE_API_URL=https://query1.finance.yahoo.com

# Alpha Vantage（需要API密钥）
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_API_URL=https://www.alphavantage.co

# 东方财富/天天基金（中国基金数据）
EASTMONEY_API_URL=http://fund.eastmoney.com
EASTMONEY_FUNDGZ_API_URL=http://fundgz.eastmoney.com
EASTMONEY_ENABLED=true

# Metals API（黄金贵金属数据）
METALS_API_KEY=
METALS_API_URL=https://api.metals.live

# News APIs（新闻数据源，请填入真实密钥）
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_API_URL=https://cryptopanic.com/api/v1/post/
NEWSAPI_KEY=
NEWSAPI_URL=https://newsapi.org/v2
SEC_API_URL=https://data.sec.gov
SEC_TICKERS_URL=https://www.sec.gov/files/company_tickers_exchange.json
# SEC要求请求带有可识别的User-Agent，生产环境建议填入项目名和联系邮箱
SEC_USER_AGENT=WealthWhisker/0.1.0 (contact: you@example.com)

# API Timeout（秒）
API_REQUEST_TIMEOUT=30
NEWS_API_TIMEOUT=15

# Data Sync Limits（数据同步数量限制）
CRYPTO_KLINE_LIMIT=168
STOCK_KLINE_LIMIT=30
FUND_DATA_LIMIT=30
NEWS_SYNC_LIMIT=20
MACRO_NEWS_LIMIT=10

# Data Sync（数据同步间隔）
DATA_SYNC_INTERVAL_MINUTES=60
CRYPTO_SYNC_INTERVAL_MINUTES=15

# Model Calibration（模型校准配置）
CALIBRATION_THRESHOLD=0.05
CRYPTO_CALIBRATION_INTERVAL_HOURS=4
STOCK_CALIBRATION_SCHEDULE=17:00

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# LLM Configuration（请填入真实配置）
LLM_ENABLED=false
LLM_API_BASE=http://localhost:8317/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen3.5-plus
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7

# Proxy（可选，用于访问外部API）
WEALTH_WHISKER_HTTP_PROXY=http://host.docker.internal:7897
WEALTH_WHISKER_HTTPS_PROXY=http://host.docker.internal:7897
