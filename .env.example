# Application
APP_NAME=WealthWhisker
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wealthwhisker
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/wealthwhisker

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External APIs
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
ALPHA_VANTAGE_API_KEY=
YAHOO_FINANCE_ENABLED=true

# Data Sync
DATA_SYNC_INTERVAL_MINUTES=60
CRYPTO_SYNC_INTERVAL_MINUTES=15

# Model Calibration
CALIBRATION_THRESHOLD=0.05
CRYPTO_CALIBRATION_INTERVAL_HOURS=4
STOCK_CALIBRATION_SCHEDULE=17:00

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log